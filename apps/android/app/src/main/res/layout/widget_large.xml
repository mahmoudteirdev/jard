<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#171C19"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#A3AEA6" android:textSize="12sp" />
    <TextView android:id="@+id/size" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#EDF1EC" android:textSize="20sp" android:textDirection="ltr" android:gravity="start" android:fontFamily="monospace" />
    <ProgressBar android:id="@+id/bar" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="6dp" android:progressTint="#F5B83D" android:progressBackgroundTint="#2E3732" android:max="100" />
    <TextView android:id="@+id/cause" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#C7D0C9" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/when_scanned" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#A3AEA6" android:textSize="12sp" />
</LinearLayout>
