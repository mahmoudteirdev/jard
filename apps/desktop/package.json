    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@babel/generator": "^8.1.0",
    "@babel/parser": "^8.1.0",
    "@babel/traverse": "^8.1.0",
    "@babel/types": "^8.1.0",
    "@tauri-apps/cli": "2.12.4",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
