{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jard",
  "version": "0.1.3",
  "identifier": "app.jard.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "جَرد",
        "width": 1440,
        "height": 900,
        "minWidth": 600,
        "minHeight": 560,
        "backgroundColor": "#101412",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Arabic",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "nsis-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "icons/installer-sidebar.bmp",
        "headerImage": "icons/installer-header.bmp"
      }
    },
    "shortDescription": "Jard: disk analyzer and cleaner",
    "publisher": "Mahmoud F.M. Abuteir"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4Q0VDNDI2NjJFNDRBRTgKUldUb1N1UmlKc1RPcUR4MWluNEVsN2t0SHJFWlU0Sk5CbGdSK0F6NzI4VWxoRGhGc0FTNmpIZ1oK",
      "endpoints": [
        "https://github.com/mahmoudteirdev/jard/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
